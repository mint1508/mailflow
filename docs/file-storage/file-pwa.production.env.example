# Copy to the repository root as .env.production on the VPS, chmod 600, and
# replace every replace-me value through the deployment secret store.
# This file is for the production Compose model. It intentionally contains no
# mock identity or fake provider defaults.
COMPOSE_PROJECT_NAME=file-pwa
FILE_DB_NAME=file_storage
FILE_DB_USER=file_storage
FILE_DB_PASSWORD=replace-me
FILE_SERVICE_PORT=14310
FILE_WEB_PORT=14300

# Promote immutable images by digest. Do not use a mutable tag in production.
FILE_SERVICE_IMAGE=ghcr.io/ORG/REPO-file-service@sha256:replace-me
FILE_WEB_IMAGE=ghcr.io/ORG/REPO-file-web@sha256:replace-me
FILE_BUILD_SHA=replace-me
FILE_IMAGE_DIGEST=sha256:replace-me

# Authentik OIDC. The client secret is optional for a public PKCE client; keep
# it set when the Authentik application is configured as confidential.
FILE_OIDC_ISSUER=https://auth.hippy.vn/application/o/files/
FILE_OIDC_AUDIENCE=hippy-files
FILE_OIDC_USERINFO_URL=https://auth.hippy.vn/application/o/userinfo/
FILE_OIDC_AUTHORIZATION_URL=https://auth.hippy.vn/application/o/authorize/
FILE_OIDC_TOKEN_URL=https://auth.hippy.vn/application/o/token/
FILE_OIDC_CLIENT_ID=hippy-files
FILE_OIDC_CLIENT_SECRET=
FILE_OIDC_REDIRECT_URI=https://files-api.hippy.vn/auth/oidc/callback
FILE_SESSION_SECRET=replace-me-with-at-least-32-random-bytes
FILE_CURSOR_SECRET=replace-me-with-at-least-32-random-bytes
FILE_LIFECYCLE_SYNC_SECRET=replace-me-with-a-long-random-secret

# Google Drive provider credentials. These are server-only and must never be
# copied into the web image, browser bundle, logs, or UAT artifacts.
FILE_GOOGLE_CLIENT_ID=replace-me
FILE_GOOGLE_CLIENT_SECRET=replace-me
FILE_GOOGLE_REFRESH_TOKEN=replace-me
FILE_GOOGLE_ROOT_FOLDER_ID=
FILE_GOOGLE_ROOT_FOLDER_NAME=Hippy Files

# Keep the metadata migration at the snapshot checkpoint during promotion.
FILE_METADATA_WRITE_MODE=snapshot
FILE_METADATA_READ_MODE=snapshot
