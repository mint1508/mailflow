# Copy to a deployment-only env file; do not commit filled values.
FILE_AUTH_MODE=mock
FILE_SERVICE_PORT=4310
FILE_WEB_PORT=4300
FILE_WEB_ORIGIN=http://localhost:4300
NEXT_PUBLIC_FILE_API_URL=http://localhost:4310
# Mock-only browser identity compiled into the pilot image. Never use in OIDC mode.
NEXT_PUBLIC_FILE_DEV_USER_ID=pilot-admin
NEXT_PUBLIC_FILE_DEV_EMAIL=pilot-admin@hippy.vn
NEXT_PUBLIC_FILE_DEV_ADMIN=true
FILE_DATA_DIR=/data
# This example is for the isolated fake-provider pilot. Production must replace
# this with google-drive; FILE_ALLOW_FAKE_PROVIDER is only for that pilot.
FILE_STORAGE_PROVIDER=fake-disk
# Production Google Drive provider (server-only secrets must be supplied by the
# deployment secret store, not committed in this file):
# FILE_STORAGE_PROVIDER=google-drive
# FILE_GOOGLE_CLIENT_ID=
# FILE_GOOGLE_CLIENT_SECRET=
# FILE_GOOGLE_REFRESH_TOKEN=
# Optional: pin an app-created root folder instead of discovering/creating it.
# FILE_GOOGLE_ROOT_FOLDER_ID=
FILE_GOOGLE_ROOT_FOLDER_NAME=Hippy Files
FILE_DB_URL=postgres://file_storage:file_storage_dev_only@postgres:5432/file_storage
FILE_REDIS_URL=redis://redis:6379
FILE_JOB_STREAM=file-jobs:v1
FILE_JOB_GROUP=file-workers:v1
FILE_JOB_DLQ=file-jobs:dlq:v1
FILE_WORKER_LEASE_MS=60000
FILE_WORKER_BLOCK_MS=1000
FILE_WORKER_MAX_ATTEMPTS=5
FILE_WORKER_RETRY_BASE_MS=1000
FILE_SCHEDULER_LOCK_MS=60000
FILE_MAINTENANCE_INTERVAL_MS=3600000
FILE_RECONCILE_INTERVAL_MS=86400000
FILE_CURSOR_SECRET=replace-with-random-32-byte-secret
FILE_CURSOR_TTL_SECONDS=900
# Relational metadata migration remains snapshot-read until the operator checkpoint.
FILE_METADATA_WRITE_MODE=snapshot
FILE_METADATA_READ_MODE=snapshot
FILE_DEFAULT_QUOTA_BYTES=10737418240
FILE_MAX_UPLOAD_BYTES=21474836480
FILE_TRASH_RETENTION_DAYS=30
FILE_RATE_LIMIT_PER_MINUTE=240
FILE_UPLOAD_GRACE_MS=300000
FILE_OIDC_ISSUER=https://auth.hippy.vn
FILE_OIDC_AUDIENCE=hippy-files
FILE_OIDC_USERINFO_URL=https://auth.hippy.vn/application/o/userinfo/
FILE_OIDC_AUTHORIZATION_URL=https://auth.hippy.vn/application/o/authorize/
FILE_OIDC_TOKEN_URL=https://auth.hippy.vn/application/o/token/
FILE_OIDC_CLIENT_ID=hippy-files
FILE_OIDC_REDIRECT_URI=https://files-api.hippy.vn/auth/oidc/callback
FILE_WEB_REDIRECT_URL=https://files.hippy.vn/
FILE_PROVIDER_RETRY_ATTEMPTS=3
FILE_PROVIDER_RETRY_BASE_MS=100
FILE_SYNTHETIC_MAX_BYTES=322122547200
# Server-only values belong in the deployment secret store, never in this file.
# FILE_OIDC_CLIENT_SECRET=
# FILE_SESSION_SECRET=
# FILE_LIFECYCLE_SYNC_SECRET=
